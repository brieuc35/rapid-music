# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

# Secrets. Une clé de compte de service Firebase contourne les règles de
# sécurité : elle donne l'accès total à la base et ne doit jamais entrer ici.
# La configuration web (apiKey, projectId…) n'est pas concernée : elle est
# publique par conception.
*serviceAccount*.json
*-adminsdk-*.json
*.pem
*.p12

# Clés de signature Android. Celle qui signe l'application envoyée au Play
# Store ne doit jamais entrer dans un dépôt public : quiconque l'obtient peut
# publier une mise à jour au nom de l'application.
*.keystore
*.jks
keystore.properties
.env
.env.*
!.env.example

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode
/coverage
/dist
/node_modules
/platforms
/plugins
/www

# Projet Android produit par Bubblewrap à partir de android/twa-manifest.json.
# Reconstruit à chaque fabrication, il n'a rien à faire dans le dépôt — et il
# contiendrait un chemin de magasin de clés.
/android/*
!/android/twa-manifest.json
.test-tmp/
