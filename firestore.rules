rules_version = '2';

// -----------------------------------------------------------------------------
//  Règles de sécurité Firestore — RapidMusic
//
//  C'est ici, et nulle part ailleurs, que se joue la protection des données.
//  La configuration du SDK (apiKey, projectId) est publique : n'importe qui
//  peut écrire une page qui parle à ce projet. Ce sont ces règles qui décident
//  ce que cette page a le droit de lire et d'écrire.
//
//  À reporter dans la console : Firestore Database → onglet Règles → Publier.
//  Ce fichier en est la référence versionnée.
// -----------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // Les données d'un artiste : lisibles et modifiables par lui seul.
    // L'identifiant du document est celui du compte, ce qui rend la règle
    // impossible à contourner — on ne peut pas demander le document d'autrui.
    match /artistes/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && valide();

      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && valide()
                    // La révision ne peut qu'avancer : une écriture fondée sur
                    // une version périmée est refusée par le serveur, et pas
                    // seulement par l'application.
                    && request.resource.data.rev > resource.data.rev;

      // Suppression du compte : un artiste doit pouvoir effacer ses données,
      // c'est un droit et non une option. Le garde-fou n'est pas ici mais dans
      // l'application, qui redemande le mot de passe avant d'y procéder — un
      // refus au niveau des règles empêcherait la suppression tout court et
      // laisserait les données orphelines après la disparition du compte.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // L'abonnement payant : lisible par son propriétaire, écrivable par
    // personne.
    //
    // C'est la seule façon, dans une application sans serveur, qu'une
    // information ne soit pas auto-attribuable. Tout ce que l'artiste écrit
    // lui-même — y compris dans /artistes/{uid} ci-dessus — est par nature
    // sous son contrôle : le navigateur écrit directement dans la base, et
    // aucune vérification faite dans l'application ne s'impose à qui la
    // contourne. Un statut payant rangé là serait donc offert à qui sait
    // ouvrir une console.
    //
    // Ici, « write: if false » ferme la porte pour tout le monde, sans
    // exception. Les écritures ne peuvent venir que de ce qui passe au-dessus
    // des règles : la console Firebase, ou plus tard une fonction serveur qui
    // aura vérifié l'encaissement auprès du prestataire de paiement.
    //
    // Le nom du document est l'identifiant du compte : on ne peut donc pas
    // demander l'abonnement de quelqu'un d'autre.
    match /abonnements/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // La file d'envoi des courriels, surveillée par l'extension « Trigger
    // Email from Firestore ». Fermée des deux côtés, sans exception.
    //
    // Le fourre-tout en fin de fichier la refuserait déjà. Elle est écrite ici
    // quand même, parce que le droit qu'elle porte n'est pas ordinaire :
    // déposer un document dans cette collection, c'est envoyer un message au
    // nom de RapidMusic, à l'adresse que l'on veut et avec le contenu que l'on
    // veut. Une règle explicite empêche qu'on l'ouvre un jour par distraction,
    // en croyant n'ouvrir qu'une collection de plus.
    //
    // Les fonctions serveur y écrivent avec les droits d'administration, qui
    // passent au-dessus de ces règles — elles n'ont donc besoin d'aucune
    // autorisation ici.
    match /mail/{id} {
      allow read, write: if false;
    }

    function valide() {
      return request.resource.data.keys().hasOnly(['rev', 'data', 'updatedAt'])
             && request.resource.data.rev is int
             && request.resource.data.rev > 0
             && request.resource.data.data is map;
    }

    // Tout le reste est fermé. Le jour où le Réseau deviendra réel, les
    // publications partagées demanderont leurs propres règles — elles n'ont
    // rien à voir avec celles-ci, puisqu'elles seront lisibles par tous.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
